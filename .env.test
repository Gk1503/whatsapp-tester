# Committed on purpose — used by `npm test` and `npm run benchmark` only.
# Contains no real secrets. config/index.js refuses to start in production
# if SESSION_SECRET matches this well-known test value.
NODE_ENV=test
TRANSPORT_MODE=mock
PORT=5051
SESSION_SECRET=test-only-secret-do-not-use-in-production-0000000000000000
MOCK_SEED=12345
LOG_LEVEL=silent
