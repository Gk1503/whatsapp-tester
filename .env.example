# Copy to .env and fill in real values. .env is gitignored — never commit it.

# development | production  (test mode uses .env.test instead, see docs/OPERATIONS.md)
NODE_ENV=development

# mock | real — mock needs no Chromium/WhatsApp session at all. Production requires
# an explicit "real" here; there is no implicit fallback to a real transport.
TRANSPORT_MODE=mock

PORT=5050

# Required. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must NOT be left blank and must NOT be the well-known test value used in .env.test.
SESSION_SECRET=

# Optional. Only used when TRANSPORT_MODE=mock — makes synthetic data/failures
# reproducible across runs. Any integer.
MOCK_SEED=12345

# Optional overrides (sane defaults apply if omitted) — see docs/OPERATIONS.md
# SESSION_IDLE_TIMEOUT_MS=1800000
# SESSION_ABSOLUTE_TIMEOUT_MS=28800000
# LOG_LEVEL=info

# Only read by `npm run create-admin`, only for non-interactive/automated
# bootstrap (e.g. a container entrypoint) — never a default credential, and
# ignored entirely once an account already exists. Leave unset to be
# prompted interactively instead.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
